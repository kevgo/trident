{
  "$schema": "https://raw.githubusercontent.com/kevgo/cucumber-sort/refs/heads/main/docs/schema.json",
  "exclude": [],
  "fail-fast": false,
  "keep-order": ["a committed file"],
  "steps": [
    "^a Git repository$",
    [
      "^a committed file",
      "^a file",
      "^I change file",
      "^I delete file",
      "^I rename file",
      "^an executable file",
      "^I ran"
    ],
    "^executing \".*\"$",
    ["^it prints", "^it does not print"],
    "^the exit code is",
    "^file \".*\" now has content$",
    "^file \".*\" now matches these lines$",
    "^file \".*\" now has an additional line matching$",
    "^file \".*\" is executable$",
    "^file \".*\" is unchanged$",
    "^file \".*\" does not exist$",
    "^all files are unchanged$$",
    [
      "^the staged changes are$",
      "^the unstaged changes are$",
      "^there are no staged changes$",
      "^there are no unstaged changes$"
    ]
  ]
}
